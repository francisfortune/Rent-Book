{
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/profile.html?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/public.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/profile.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}